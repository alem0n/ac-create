{
  "name": "myapp",
  "version": "0.1.0",
  "description": "TypeScript 项目模板（AI Agent 生成软件工程最佳实践）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "pnpm lint && pnpm run typecheck && pnpm run format:check && pnpm run test:coverage && pnpm audit --prod"
  },
  "dependencies": {
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
